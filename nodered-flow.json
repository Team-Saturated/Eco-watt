[
    {
        "id": "flow1",
        "type": "tab",
        "label": "EcoWatt Dashboard",
        "disabled": false,
        "info": ""
    },
    {
        "id": "http-in",
        "type": "http in",
        "z": "flow1",
        "name": "Receive Upload",
        "url": "/api/inverter/upload",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 140,
        "y": 100,
        "wires": [["process"]]
    },
    {
        "id": "process",
        "type": "function",
        "z": "flow1",
        "name": "Process Data",
        "func": "// Extract payload\nvar payload = msg.payload;\nvar compressed_size = payload.length;\n\n// Simulate decompression stats\nvar original_size = compressed_size * 3; // estimate\nvar ratio = original_size / compressed_size;\n\n// Create response\nvar response = {\n    status: \"OK\",\n    compressed_bytes: compressed_size,\n    original_bytes_est: original_size,\n    compression_ratio: ratio.toFixed(2),\n    timestamp: new Date().toISOString()\n};\n\n// Send to dashboard\nnode.send([{payload: response}, {payload: response, topic: \"upload\"}]);\n\nreturn null;",
        "outputs": 2,
        "noerr": 0,
        "x": 320,
        "y": 100,
        "wires": [["http-response"], ["dashboard"]]
    },
    {
        "id": "http-response",
        "type": "http response",
        "z": "flow1",
        "name": "Send Response",
        "statusCode": "200",
        "headers": {},
        "x": 520,
        "y": 80,
        "wires": []
    },
    {
        "id": "dashboard",
        "type": "ui_chart",
        "z": "flow1",
        "name": "Compression Chart",
        "group": "dashboard-group",
        "order": 1,
        "width": 0,
        "height": 0,
        "label": "Compression Ratio",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "No Data",
        "dot": false,
        "ymin": "0",
        "ymax": "10",
        "removeOlder": 1,
        "removeOlderPoints": "",
        "removeOlderUnit": "3600",
        "cutout": 0,
        "useOneColor": false,
        "colors": ["#1f77b4"],
        "x": 520,
        "y": 120,
        "wires": [[]]
    }
]