    {
        "id": "feab598ea058f0e8",
        "type": "function",
        "z": "52659386e15446f9",
        "name": "Parse Solar Data",
        "func": "// Parse solar inverter data for chart and gauge\nconst solarData = msg.payload || {};\n\nif (solarData.data && solarData.data.length > 0) {\n  const voltageData = solarData.data.map(r => ({ x: new Date(r.timestamp), y: r.voltage }));\n  const latestVoltage = solarData.data[solarData.data.length - 1].voltage;\n\n  node.send([{ payload: [{ series: [\"Voltage\"], data: [voltageData], labels: [] }] }, { payload: latestVoltage }]);\n} else {\n  node.send([{ payload: [] }, { payload: 0 }]);\n}\nreturn null;",
        "outputs": 2,
