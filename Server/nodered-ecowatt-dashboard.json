    },
    {
        "id": "0cdb48cbc6a67415",
        "type": "function",
        "z": "a61f5462f5db61a1",
        "name": "Parse History",
        "func": "// Parse compression history from Flask server\nconst historyData = msg.payload;\n\nif (historyData.history && historyData.history.length > 0) {\n  const compressionChart = historyData.history.map(record => ({ x: new Date(record.timestamp), y: record.compression_ratio }));\n  const bytesChart = historyData.history.map(record => ({ x: new Date(record.timestamp), original: record.original_bytes, compressed: record.compressed_bytes }));\n\n  msg.payload = { compression_chart: compressionChart, bytes_chart: bytesChart, total_uploads: historyData.total_uploads, avg_compression: historyData.avg_compression ? historyData.avg_compression.toFixed(1) + ':1' : '0:1' };\n} else {\n  msg.payload = { compression_chart: [], bytes_chart: [], total_uploads: 0, avg_compression: '0:1' };\n}\n\nmsg.topic = 'compression_history';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
