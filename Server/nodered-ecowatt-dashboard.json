    {
        "id": "ab8703a46b912ee4",
        "type": "function",
        "z": "52659386e15446f9",
        "name": "Parse History",
        "func": "// Parse compression history into chart-friendly format\nconst historyData = msg.payload || {};\n\nif (historyData.history && historyData.history.length > 0) {\n  const compressionPoints = historyData.history.map(r => ({ x: new Date(r.timestamp), y: r.compression_ratio }));\n  const bytePoints = historyData.history.map(r => ({ x: new Date(r.timestamp), y: r.original_bytes }));\n  const compressedPoints = historyData.history.map(r => ({ x: new Date(r.timestamp), y: r.compressed_bytes }));\n\n  node.send([\n    { payload: [{ series: [\"Ratio\"], data: [compressionPoints], labels: [] }] },\n    { payload: [{ series: [\"Original\", \"Compressed\"], data: [bytePoints, compressedPoints], labels: [] }] }\n  ]);\n} else {\n  node.send([{ payload: [] }, { payload: [] }]);\n}\nreturn null;",
