        "id": "6d34605dfb5f7baf",
        "type": "function",
        "z": "a61f5462f5db61a1",
        "name": "Parse Stats",
        "func": "// Parse compression statistics from Flask server\nconst stats = msg.payload;\n\nmsg.payload = {\n  timestamp: new Date(stats.timestamp).toLocaleString(),\n  device_id: stats.device_id || 'Unknown',\n  total_uploads: stats.total_uploads || 0,\n  records: stats.records || 0,\n  original_bytes: stats.original_bytes || 0,\n  compressed_bytes: stats.compressed_bytes || 0,\n  compression_ratio: stats.compression_ratio ? stats.compression_ratio.toFixed(1) + ':1' : '0:1',\n  space_saved: stats.space_saved ? stats.space_saved.toFixed(1) + '%' : '0%',\n  upload_time: stats.upload_time || 'Never'\n};\n\nmsg.topic = 'compression_stats';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 100,
        "wires": [
            [
                "ccc206f4f7398794",
                "471963a78263653a"
            ]
        ]
    },
    {
        "id": "7af2af6681dd3485",
        "type": "function",
        "z": "a61f5462f5db61a1",
        "name": "Parse Solar Data",
        "func": "// Parse solar inverter data from Flask server\nconst solarData = msg.payload;\n\nif (solarData.data && solarData.data.length > 0) {\n  const voltageData = solarData.data.map(record => ({ x: new Date(record.timestamp), y: record.voltage }));\n  const latestVoltage = solarData.data[solarData.data.length - 1].voltage;\n\n  msg.payload = {\n    voltage_data: voltageData,\n    latest_voltage: latestVoltage,\n    record_count: solarData.count,\n    last_update: solarData.last_update,\n    device: solarData.data[0].device || 'ESP32'\n  };\n} else {\n  msg.payload = { voltage_data: [], latest_voltage: 0, record_count: 0, last_update: 'No data', device: 'ESP32' };\n}\n\nmsg.topic = 'solar_data';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 200,
        "wires": [
