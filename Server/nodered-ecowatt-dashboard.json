        "id": "5f1369ed9fc9c2b6",
        "type": "function",
        "z": "52659386e15446f9",
        "name": "Parse Stats",
        "func": "// Parse compression statistics for UI\nconst stats = msg.payload || {};\n\nmsg.payload = {\n  timestamp: stats.timestamp ? new Date(stats.timestamp).toLocaleString() : 'N/A',\n  device_id: stats.device_id || 'Unknown',\n  total_uploads: stats.total_uploads || 0,\n  records: stats.records || 0,\n  original_bytes: stats.original_bytes || 0,\n  compressed_bytes: stats.compressed_bytes || 0,\n  compression_ratio: stats.compression_ratio ? Number(stats.compression_ratio.toFixed(2)) : 0,\n  space_saved: stats.space_saved || 0,\n  upload_time: stats.upload_time || 'Never'\n};\n\n// For gauge, send numeric ratio separately\nnode.send([{ ...msg, topic: 'stats' }, { payload: stats.compression_ratio ? Number(stats.compression_ratio.toFixed(2)) : 0 }]);\nreturn null;\n",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
